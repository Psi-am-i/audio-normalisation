*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# Packaging build outputs (GUI)
packaging/build-gui/
packaging/dist-gui/

# The app's own background texture IS tracked (gui_assets/vinyl-texture.jpg) —
# without it CI has no image and make_bg.py falls back to a flat procedural
# gradient, which is exactly how the shipped apps ended up with no texture.
#
# A personal photo dropped in as background_source.* still overrides it locally
# and stays out of this public repo. background.png is generated output.
gui_assets/background_source.*
gui_assets/background.png

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

